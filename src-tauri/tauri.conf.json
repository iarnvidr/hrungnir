{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hrungnir",
  "version": "0.6.16",
  "identifier": "io.github.iarnvidr.hrungnir",
  "build": { "frontendDist": "../reader" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Hrungnir", "width": 1100, "height": 780, "minWidth": 720, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: asset: http://asset.localhost http://127.0.0.1:*; media-src asset: http://asset.localhost http://127.0.0.1:* https://v.redd.it; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "assetProtocol": {"enable": true, "scope": ["$APPDATA/media/**"]}
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/iarnvidr/hrungnir/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNDczRkIwMTg1QzFCQUIKUldTckcxd1lzRDlIRXhYYzR5N0Vway96cU9rRmhDaGhDV2RtZjc3RjdBb1Z5TkNMZldORGdQancK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": { "../licenses/": "licenses/" },
    "copyright": "Copyright (c) 2026 Esben Thomsen",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "shortDescription": "A Reddit reader with downloaded comments and local media",
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
